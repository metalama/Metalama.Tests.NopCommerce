<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants Condition="'$(RegressionTest)' == 'true'">$(DefineConstants);REGRESSION_TEST</DefineConstants>
    <!-- Enable DAILY_BUILDS mode to benchmark against daily builds from commits directory -->
    <!-- Usage: dotnet run -c Release -p:DailyBuilds=true -->
    <DefineConstants Condition="'$(DailyBuilds)' == 'true'">$(DefineConstants);DAILY_BUILDS;TYPICAL</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.13.12" />
  </ItemGroup>

</Project>
