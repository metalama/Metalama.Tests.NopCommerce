<Project>

  <PropertyGroup>
    <RepoDirectory>$(MSBuildThisFileDirectory)</RepoDirectory>
    <RepoKind>GitHub</RepoKind>
    <DefineConstants Condition=" '$(ExtraConstants)' != '' ">$(DefineConstants);$(ExtraConstants)</DefineConstants>

    <!-- Path to daily builds directory (relative to Metalama repo root) -->
    <MetalamaCommitsRoot Condition="'$(MetalamaCommitsRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\Metalama\commits'))</MetalamaCommitsRoot>
  </PropertyGroup>

  <!--
    When MetalamaCommitDate is specified (e.g., 2025-10-03), import the daily build's version props.
    This allows benchmarking against specific daily builds of Metalama.
    Usage: dotnet build -p:MetalamaCommitDate=2025-10-03
  -->
  <Import
    Project="$(MetalamaCommitsRoot)\$(MetalamaCommitDate)\Metalama.version.props"
    Condition="'$(MetalamaCommitDate)' != '' AND Exists('$(MetalamaCommitsRoot)\$(MetalamaCommitDate)\Metalama.version.props')" />

  <Import Project="eng\Versions.props"/>
  <Import Project="eng\Packaging.props"/>
  <Import Sdk="PostSharp.Engineering.Sdk" Project="BuildOptions.props"/>
  <Import Sdk="PostSharp.Engineering.Sdk" Project="StrongName.props"/>
  <Import Sdk="PostSharp.Engineering.Sdk" Project="SourceLink.props"/>

  <PropertyGroup>
    <LangVersion>13.0</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="BenchmarkedTypesPercentage" />
    <CompilerVisibleProperty Include="BenchmarkedMembersPercentage" />
  </ItemGroup>

</Project>
